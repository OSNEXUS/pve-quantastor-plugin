#!/bin/sh
set -e

TPLFILE=/usr/share/pve-manager/index.html.tpl

remove_script_tag() {
    if [ -f "$TPLFILE" ]; then
        sed -i '/quantastor-storage\.js/d' "$TPLFILE"
    fi
}

case "$1" in
    remove|upgrade|deconfigure)
        # Remove the UI script tag from the PVE web UI HTML template. On upgrade
        # this round-trips: postinst re-injects it on configure.
        remove_script_tag

        # Remove the QuantaStorScan require line from Scan.pm.
        # Use the full literal string to avoid accidentally matching unrelated lines.
        SCANFILE=/usr/share/perl5/PVE/API2/Storage/Scan.pm
        if [ -f "$SCANFILE" ]; then
            sed -i '/require PVE::API2::Storage::QuantaStorScan;/d' "$SCANFILE"
        fi
        ;;
esac

# Warn about leftover 'quantastor' storage entries ONLY on an actual uninstall.
# On upgrade/deconfigure the package (and its storages) are staying, so the
# "remove them before uninstalling" caution would be misleading noise — it used
# to fire on every deb upgrade.
if [ "$1" = "remove" ]; then
    cfg=/etc/pve/storage.cfg
    if [ -f "$cfg" ] && grep -q '^quantastor:' "$cfg" 2>/dev/null; then
        echo "WARNING: storage.cfg still contains 'quantastor' storage entries." >&2
        echo "Remove them via the PVE UI or pvesm before uninstalling." >&2
    fi
fi

#DEBHELPER#
exit 0
